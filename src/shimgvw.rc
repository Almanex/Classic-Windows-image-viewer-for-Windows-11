#pragma code_page(65001)

#include <windows.h>

LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT

1 ICON "shimgvw.ico"
1 RT_MANIFEST "shimgvw.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "Community Project"
            VALUE "FileDescription", "Classic image viewer for Windows 10/11"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "PhotoViewer"
            VALUE "LegalCopyright", "Open Source Project - https://github.com/Almanex/Sredstvo_prosmotra_fotografij"
            VALUE "OriginalFilename", "PhotoViewer.exe"
            VALUE "ProductName", "Shell Image Viewer"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
